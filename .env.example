# ---- AI (OpenAI 호환 API) ----
OPENAI_API_KEY=
# 비우면 OpenAI 공식 API. Codyssey 공개 API 사용 시: https://copa.codyssey.kr/v1
OPENAI_BASE_URL=https://copa.codyssey.kr/v1
OPENAI_MODEL=gpt-5-mini
OPENAI_MAX_TOKENS=2000
# Codyssey 게이트웨이는 미지원 → 비워둠 (OpenAI 공식 API면 low 권장)
OPENAI_REASONING_EFFORT=
CHAT_RATE_LIMIT_PER_MINUTE=10

# ---- Firebase (둘 중 하나) ----
# 로컬: 서비스 계정 키 파일 경로
FIREBASE_SERVICE_ACCOUNT_PATH=backend/firebase-service-account.json
# 배포(Render): 키 JSON 전체를 한 줄로
FIREBASE_SERVICE_ACCOUNT_JSON=

# ---- 서버 ----
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
APP_TIMEZONE=Asia/Seoul

# ---- 프론트엔드 (Vercel 환경변수) ----
API_BASE_URL=http://127.0.0.1:8000
